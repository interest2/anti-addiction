<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="#FFFFFF">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp">

        <!-- 顶部行：APP名称靠左，监测开关靠右 -->
        <LinearLayout
            android:id="@+id/row_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 删除按钮 - 仅手动添加的APP显示 -->
            <TextView
                android:id="@+id/btn_delete_app"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="#999999"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_app_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:text="APP 名称"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 监测开关 -->
            <ToggleButton
                android:id="@+id/toggle_monitor"
                android:layout_width="36dp"
                android:layout_height="18dp"
                android:background="@drawable/toggle_switch_background"
                android:checked="false"
                android:textOff=""
                android:textOn="" />

        </LinearLayout>

        <!-- 主要内容区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/row_top"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:id="@+id/tv_remaining_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:text="剩余时长: 00:00"
                android:textSize="12sp"
                android:textColor="#666666"
                android:maxLines="1"
                android:gravity="start" />

            <TextView
                android:id="@+id/tv_relaxed_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="2dp"
                android:text="宽松剩余: 3次"
                android:textSize="12sp"
                android:textColor="#666666"
                android:gravity="start" />

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView> 