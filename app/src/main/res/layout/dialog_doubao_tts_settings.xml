<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="在火山引擎控制台开通「语音合成」服务后，将以下参数填在此处；留空则听力题回退占位音频。"
            android:textSize="13sp"
            android:textColor="#888888"
            android:lineSpacingMultiplier="1.2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="AppID"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/et_doubao_tts_app_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="应用 ID"
            android:inputType="text"
            android:maxLength="64"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Token"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/et_doubao_tts_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="访问令牌"
            android:inputType="text"
            android:maxLength="128"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cluster（集群）"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/et_doubao_tts_cluster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="如 volcano_tts"
            android:inputType="text"
            android:maxLength="64"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="音色代号 VoiceType"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/et_doubao_tts_voice_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="在线音色类型，如 BV001_streaming"
            android:inputType="text"
            android:maxLength="64"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="发音人 Voice"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/et_doubao_tts_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="在线发音人，如 zh_female_qingxinnvsheng_mars_bigtts"
            android:inputType="text"
            android:maxLength="64"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
