<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="添加新 APP"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <!-- 从已安装 APP 选择：自动填入 APP 名称与包名 -->
    <Button
        android:id="@+id/btn_pick_installed_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="从已安装 APP 选择"
        android:textColor="@android:color/white"
        android:backgroundTint="#4CAF50"
        app:icon="@drawable/ic_menu_log"
        app:iconTint="@android:color/white"
        android:layout_marginBottom="16dp"
        style="@style/Widget.Material3.Button" />

    <!-- 已选应用展示（选中后才显示名称与包名，只读） -->
    <LinearLayout
        android:id="@+id/layout_selected_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        android:background="@drawable/bg_selected_app">

        <ImageView
            android:id="@+id/iv_selected_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_selected_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未选择应用"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tv_selected_package"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="请点击上方按钮选择应用"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#757575" />

        </LinearLayout>

    </LinearLayout>

    <!-- 屏蔽关键词 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="屏蔽关键词（若输入多个则空格分隔）"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_target_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="常见的有：推荐、发现、热榜"
        app:hintTextColor="#757575"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_target_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="14sp"
            android:padding="12dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- 宽松模式次数 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="宽松模式次数"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_relaxed_limit_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="默认值为 1，可填 1-3"
        app:hintTextColor="#757575"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_relaxed_limit_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="1"
            android:maxLines="1"
            android:text="1"
            android:textSize="14sp"
            android:padding="12dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="取消"
            android:layout_marginEnd="8dp"
            style="@style/Widget.Material3.Button.TextButton" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保存"
            style="@style/Widget.Material3.Button" />

    </LinearLayout>

</LinearLayout> 
