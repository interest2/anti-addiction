<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/challenge_type_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <!-- 答题计时：不显示 / 显示分钟（mm）/ 显示分钟和秒（mm:s），默认显示分钟和秒 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="答题计时"
            android:textColor="#202020"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_timer_none"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_challenge_timer_option"
                android:gravity="center"
                android:singleLine="true"
                android:text="不显示"
                android:textColor="@color/text_challenge_timer_option"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_timer_minutes"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_challenge_timer_option"
                android:gravity="center"
                android:singleLine="true"
                android:text="分钟 mm"
                android:textColor="@color/text_challenge_timer_option"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_timer_minutes_seconds"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_challenge_timer_option"
                android:gravity="center"
                android:singleLine="true"
                android:text="分钟和秒 mm:s"
                android:textColor="@color/text_challenge_timer_option"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:text="仅算术 / 推理 / 混合题生效，听力、复述除外"
            android:textColor="#999999"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
