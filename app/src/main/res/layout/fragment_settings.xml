<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_goal_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="其他设置"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 版本更新区域 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp">
            
            <TextView
                android:id="@+id/tv_version_update_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="版本更新"
                android:textSize="20sp"
                android:textStyle="bold" />
            
            <RelativeLayout
                android:id="@+id/iv_version_update_red_dot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignTop="@id/tv_version_update_title"
                android:layout_toEndOf="@id/tv_version_update_title"
                android:layout_marginStart="4dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/red_badge_with_1"
                android:visibility="gone">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="1"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:gravity="center" />
                    
            </RelativeLayout>
                
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_version_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本机当前1.0.0，云端最新1.0.1"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btn_latest_apk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="最新安装包地址"
            android:backgroundTint="#7C4DFF"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />


        <!-- 悬浮窗设置标题 -->
        <TextView
            android:id="@+id/tv_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="悬浮窗设置"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 悬浮窗设置按钮 -->
        <Button
            android:id="@+id/btn_floating_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="调整悬浮窗边缘位置"
            android:backgroundTint="#FFA000"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginBottom="32dp" />

        <!-- 其它说明 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="若悬浮窗到时间未显示，首先检查“允许后台运行”权限是否确实开启了，以及是否关闭了“省电模式”；如果是，可尝试点击下面的按钮修复"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- 重置按钮 -->
        <Button
            android:id="@+id/btn_reset_floating_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="重置所有APP悬浮窗状态"
            android:backgroundTint="#E91E63"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- 包名日志：标签 + 拟物开关 + 查看，靠左 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="记录包名"
                android:textSize="16sp"
                android:textColor="@android:color/black" />

            <ToggleButton
                android:id="@+id/toggle_package_log"
                android:layout_width="44dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/toggle_switch_background_large"
                android:textOff=""
                android:textOn=""
                android:checked="false" />

            <Button
                android:id="@+id/btn_package_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="包名日志"
                android:backgroundTint="#607D8B"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>