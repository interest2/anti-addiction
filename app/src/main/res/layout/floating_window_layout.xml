<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCF8EB"
    android:clickable="true"
    android:focusable="true">

    <!-- 顶部信息区域 -->
    <LinearLayout
        android:id="@+id/top_info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/floating_window_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="理性提醒"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.12"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="小红书应用正在运行"
            android:textColor="#EEEEEE"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tv_unlock_duration_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:text="下次解禁时长 1 分钟"
            android:textColor="#B0B0B0"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 数学题验证区域：内部控件首次使用时再加载，减少悬浮窗首帧前的 inflate 工作。 -->
    <FrameLayout
        android:id="@+id/math_challenge_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_info_layout"
        android:layout_marginTop="10dp"
        android:background="@drawable/floating_window_bg"
        android:visibility="gone">

        <ViewStub
            android:id="@+id/math_challenge_stub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout="@layout/floating_math_challenge_content" />

    </FrameLayout>

    <!-- 复述题验证区域：与数学题类似，首次使用时再懒加载 -->
    <FrameLayout
        android:id="@+id/retelling_challenge_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/top_info_layout"
        android:layout_marginTop="10dp"
        android:background="@drawable/floating_window_bg"
        android:visibility="gone">

        <ViewStub
            android:id="@+id/retelling_challenge_stub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout="@layout/floating_retelling_challenge_content" />

    </FrameLayout>

    <!-- 日常提醒区域 -->
    <LinearLayout
        android:id="@+id/strict_reminder_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/math_challenge_layout"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:background="#FCF8EB"
        android:orientation="vertical"
        android:padding="5dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_strict_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="有志者事竟成"
            android:textColor="#F44336"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="start"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tv_strict_reminder_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="此文字修改方式：APP底栏-个性化->座右铭"
            android:textColor="#4CAF50"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:gravity="center" />

    </LinearLayout>

    <!-- 关闭按钮 - 右上角 -->
    <Button
        android:id="@+id/btn_close"
        android:layout_width="80dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="10dp"
        android:text="关闭"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:backgroundTint="#FF6B6B"
        android:gravity="center" />

</RelativeLayout>
