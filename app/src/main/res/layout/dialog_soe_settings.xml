<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="在腾讯云控制台开通「智聆口语评测（SOE）」后填写以下参数；留空则复述题回退本地识别 + 纯文本评分。"
            android:textSize="13sp"
            android:textColor="#888888"
            android:lineSpacingMultiplier="1.2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="AppID"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/et_soe_app_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="腾讯云账号 AppID"
            android:inputType="text"
            android:maxLength="64"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SecretId"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/et_soe_secret_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="访问密钥 SecretId"
            android:inputType="text"
            android:maxLength="128"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="SecretKey"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/et_soe_secret_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="访问密钥 SecretKey"
            android:inputType="textPassword"
            android:maxLength="128"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="评分苛刻指数 ScoreCoeff"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/et_soe_score_coeff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1.0 - 4.0，默认 1.5，越大越严格"
            android:inputType="numberDecimal"
            android:maxLength="4"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="注意：SecretKey 保存在本机（MMKV），仅供本地验证；正式发布建议改用后端签发短期签名 URL，避免密钥落入 APK。"
            android:textSize="12sp"
            android:textColor="#CC6600"
            android:lineSpacingMultiplier="1.2" />

    </LinearLayout>
</ScrollView>
